
; ignore this!

; import everything here is as one thing!

set (WORD_SIZE = 4)

component D-latch (clk,d) (sto) (
	enable  = clk&d
	disable = clk&~d
	sto = ~(nto|enable )
	nto = ~(sto|disable)
)

module 2-1-multiplex (sel,a,b) (out) (
	posA = a&sel
	posB = b&~sel
	out = posA|posB
)
module main (sel:4,a:4,b:4,clk) (data:4) (
	; for comments
	repeat (N,0,WORD_SIZE) (
		@2-1-multiplex(sel:N,a:N,b:N)(plexed:N)
		@D-latch(clk,plexed:N)(data:N)
	)
)
