
set (N=16)

component mux(a,b,sel)(out) (
	out = (a&~sel)|(b&sel)
)

component muxN(a:N,b:N,sel)(out:N) (
	repeat (I,0,N) (
		@mux(a:I,b:I,sel)(out:I)
	)
)

component xor(a,b) (out) (
	out = (~a&b)|(a&~b)
	:out = (a|b)&(~a|~b)
)

component halfAdder(a,cIn)(dOut,cOut) (
	@xor(a,cIn)(dOut)
	;dOut = (~a&cIn)|(a&~cIn)
	cOut = a&cIn
)
component fadd(a,b,c)(fullXor,fullAnd) (
	@xor(a,b)(halfXor)
	@xor(halfXor,c)(fullXor)
	fullAnd = (a&b)|(c&halfXor)
)
component fsubC(a,b)(fullXor,fullAnd) (
	@xor(a,b)(halfXor)
	fullXor = ~halfXor
	fullAnd = (a&b)|halfXor
)

component sub16(a:16,b:16)(subl:16) (
	repeat (I,0,16) (
		nb:I = ~b:I
	)
	@fsubC(a: 0,nb: 0     )(subl: 0,c: 0)
	@fadd (a: 1,nb: 1,c: 0)(subl: 1,c: 1)
	@fadd (a: 2,nb: 2,c: 1)(subl: 2,c: 2)
	@fadd (a: 3,nb: 3,c: 2)(subl: 3,c: 3)
	@fadd (a: 4,nb: 4,c: 3)(subl: 4,c: 4)
	@fadd (a: 5,nb: 5,c: 4)(subl: 5,c: 5)
	@fadd (a: 6,nb: 6,c: 5)(subl: 6,c: 6)
	@fadd (a: 7,nb: 7,c: 6)(subl: 7,c: 7)
	@fadd (a: 8,nb: 8,c: 7)(subl: 8,c: 8)
	@fadd (a: 9,nb: 9,c: 8)(subl: 9,c: 9)
	@fadd (a:10,nb:10,c: 9)(subl:10,c:10)
	@fadd (a:11,nb:11,c:10)(subl:11,c:11)
	@fadd (a:12,nb:12,c:11)(subl:12,c:12)
	@fadd (a:13,nb:13,c:12)(subl:13,c:13)
	@fadd (a:14,nb:14,c:13)(subl:14,c:14)
	@fadd (a:15,nb:15,c:14)(subl:15,c:15)
)
component leq16(a:16) (cond) (
	cond = a:15 | ~(
		a: 0 | a: 1 | a: 2 | a: 3 |
		a: 4 | a: 5 | a: 6 | a: 7 |
		a: 8 | a: 9 | a:10 | a:11 |
		a:12 | a:13 | a:14 | a:15
	)
)
component increment1-16(a:16)(incr:16) (
	incr:0 = ~a:0
	car:0 = a:0
	@halfAdder(a: 1,car: 0)(incr: 1,car: 1)
	@halfAdder(a: 2,car: 1)(incr: 2,car: 2)
	@halfAdder(a: 3,car: 2)(incr: 3,car: 3)
	@halfAdder(a: 4,car: 3)(incr: 4,car: 4)
	@halfAdder(a: 5,car: 4)(incr: 5,car: 5)
	@halfAdder(a: 6,car: 5)(incr: 6,car: 6)
	@halfAdder(a: 7,car: 6)(incr: 7,car: 7)
	@halfAdder(a: 8,car: 7)(incr: 8,car: 8)
	@halfAdder(a: 9,car: 8)(incr: 9,car: 9)
	@halfAdder(a:10,car: 9)(incr:10,car:10)
	@halfAdder(a:11,car:10)(incr:11,car:11)
	@halfAdder(a:12,car:11)(incr:12,car:12)
	@halfAdder(a:13,car:12)(incr:13,car:13)
	@halfAdder(a:14,car:13)(incr:14,car:14)
	@halfAdder(a:15,car:14)(incr:15,car:15)
)
component D-latch (clk,d) (sto) (
	enable  = clk&d
	disable = clk&~d
	sto = ~(nto|enable )
	nto = ~(sto|disable)
)
component D-latchN(clk,d:N) (sto:N) (
	repeat (I,0,N) (
		@D-latch(clk,d:I)(sto:I)
	)
)
component SR-latch (high,low)(outp) (
	pout = ~( low|nout)
	nout = ~(high|pout)
	outp = ~nout
)

; constraint : the clock signal can't be longer than a few ticks
module main(stageClk:10,getValue:N,reset)(addr:N,setValue:N,doWrite) (
	; stages:
	; 0. getRefA
	;    incr PC
	; 1. *getValueOfA (short)
	;    latch PC to ptr
	; 2. getRefB
	;    incr PC
	; 3. *getValueOfB (short)
	;    auto compute A - B
	;    latch PC to ptr
	; 4. jump (inc or getValue)
	;    put A - B into buffer???
	; 5. signal write A - B (short????)
	;    latch PC to ptr


	@SR-latch(reset,clkWrite)(resetSig)
	; clocks
	clkRefA  = stageClk:0
	clkValA  = stageClk:1
	clkRefB  = stageClk:2
	clkValB  = stageClk:3
	clkJump  = stageClk:4
	clkWrite = stageClk:5
	doWrite  = clkWrite

	clkLatchPC = clkValA | clkValB | clkWrite
	clkIncrement = clkRefA | clkRefB | clkJump
	clkReRef = clkRefA | clkRefB
	clkOutPoint = clkLatchPC | clkRefA | clkRefB


	; getValueA
	@D-latchN(clkValA,getValue)(valueA)
	; getValueB
	@D-latchN(clkValB,getValue)(valueB)

	; pointing loop
	@D-latchN(clkIncrement,pointer)(pState)
	@increment1-16(pState)(pInc)  ; incr PC
	@muxN(pInc,getValue,doSwitch)(swPoint)
	repeat (I,0,N) (
		pointer:I = swPoint:I & ~resetSig
	)

	; bufferedOutput
	@D-latchN(clkOutPoint,pointingTo)(addr) ; latch
	repeat (I,0,N) (
		setValue:I = doWrite & valueOut:I
	)
	repeat (I,0,N) (
		doGetValue:I = getValue:I & clkReRef
		doGetRef  :I = pState:I & clkLatchPC
		pointingTo:I = doGetRef:I | doGetValue:I
	)

	; subtract
	@sub16(valueA,valueB)(valueOut)
	@leq16(valueOut)(doJump)
	doSwitch = doJump & clkJump


)



