
component D-latch (clk,d) (sto) (
	setHigh = clk&d
	setLow  = clk&~d
	sto = ~(nto|setHigh)
	nto = ~(sto|setLow )
)

module 2-1-multiplex (sel,a,b) (out) (
	posA = a&sel
	posB = b&~sel
	out = posA|posB
)
module main (sel,a,b,clk) (data) (
	@2-1-multiplex(sel,a,b,plexed)
	@D-latch(clk,plexed,data)
)
