component bit-16-lower-8 (a:16) (b:8) (
	b:0 = a:0
	b:1 = a:1
	b:2 = a:2
	b:3 = a:3
	b:4 = a:4
	b:5 = a:5
	b:6 = a:6
	b:7 = a:7
)
component bit-16-upper-8 (a:16) (b:8) (
	b:0 = a:8
	b:1 = a:9
	b:2 = a:10
	b:3 = a:11
	b:4 = a:12
	b:5 = a:13
	b:6 = a:14
	b:7 = a:15
)

component xor (a,b) (xo,and) (
	and =  a& b
	nnd = ~a&~b
	xo = ~(and|nnd)
)

component bit-adder (a,b,carry) (bit-out,carry-out) (
	@xor(a,b,  st0xor,st0and)

	@xor(st0xor,carry,  bit-out,st1and)
	carry-out = st0and|st1and
)

module main (a:4,b:4,c) (out:4,carry) (
	@bit-adder(a:0,b:0,c ,  out:0,   c1)
	@bit-adder(a:1,b:1,c1,  out:1,   c2)
	@bit-adder(a:2,b:2,c2,  out:2,   c3)
	@bit-adder(a:3,b:3,c3,  out:3,carry)
)
